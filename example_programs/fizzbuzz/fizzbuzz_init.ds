# fizzbuzz_init.ds - One-time initialization for FizzBuzz tape state.
#
# Sets:
#   c4 (C_UNTIL10) = 10
#   c8 (C_MOD3)    = 3
#   c11 (C_MOD5)   = 5
#   c14 (C_NEITHER)= 1
#   c15 (C_LOOPCNT)= 100
#
# Pre: all cells 0, ptr at c0.
# Post: tape initialized, ptr at c0.

GEAR 4 RIGHT GEAR 5 GAS GEAR 5 GAS # c4 = 10
GEAR 4 RIGHT GEAR 3 GAS # c8 = 3
GEAR 3 RIGHT GEAR 5 GAS # c11 = 5
GEAR 5 RIGHT GEAR 5 GAS GEAR 5 GAS # move to c16, store 10 (temp) 
PARK 
	LEFT GEAR 5 GAS GEAR 5 GAS # c15 += 10
	RIGHT BRAKE # c16 -= 1
DRIVE 

GEAR 2 LEFT GAS # move from c16->c14, c14=1
GEAR 5 LEFT GEAR 5 LEFT GEAR 4 LEFT # move c14 -> c0
