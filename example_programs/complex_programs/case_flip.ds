# case_flip.ds - Echo input with the case of letters flipped.
#
# Demonstrates LISTEN (input), looping until EOF, and range-checking
# arithmetic. For each input character:
#   - If it is uppercase A-Z (ASCII 65-90), add 32 -> lowercase.
#   - If it is lowercase a-z (ASCII 97-122), subtract 32 -> uppercase.
#   - Otherwise pass through unchanged.
# Stops when LISTEN returns 0 (EOF).
#
# Tape layout used here:
#   c0 : current character
#   c2 : is_upper flag      (set by inline range_check macro)
#   c3 : is_lower flag      (set by inline range_check macro)
#   c4..c7 : scratch cells used by range_check
#
# Range check pattern: copy source to a temp, subtract the lower bound,
# then run a coupled countdown of (temp, counter) initialised to
# (source-lower, upper-lower+1). If the counter has anything left when
# temp hits zero, the source was in [lower, upper].
#
# Run it like:
#   python3 drivescript_interpreter.py case_flip.ds --input "Hello, World!"
# Output:
#   hELLO, wORLD!
--
# ── Read first character ──
LISTEN

# ── Main loop: process while input is not EOF ──
PARK

  # ── Copy c0 → c4 (nondestructive, restore via c6) ──
  PARK
    BRAKE
    GEAR 4 RIGHT GAS           # c4++
    GEAR 2 RIGHT GAS           # c6++
    GEAR 5 LEFT LEFT           # back to c0
  DRIVE
  GEAR 5 RIGHT RIGHT          # go to c6
  PARK
    BRAKE
    GEAR 5 LEFT LEFT GAS       # c0++
    GEAR 5 RIGHT RIGHT         # back to c6
  DRIVE
  GEAR 5 LEFT LEFT             # back to c0

  # ══════════════════════════════════════════
  # UPPERCASE CHECK: is c0 in A-Z (65-90)?
  # ══════════════════════════════════════════

  # Subtract 65 from c4  (13 × GEAR 5 BRAKE = 65)
  GEAR 4 RIGHT
  GEAR 5 BRAKE GEAR 5 BRAKE GEAR 5 BRAKE GEAR 5 BRAKE
  GEAR 5 BRAKE GEAR 5 BRAKE GEAR 5 BRAKE GEAR 5 BRAKE
  GEAR 5 BRAKE GEAR 5 BRAKE GEAR 5 BRAKE GEAR 5 BRAKE
  GEAR 5 BRAKE
  GEAR 4 LEFT

  # Set c5 = 26  (range width: 90 − 65 + 1)
  GEAR 5 RIGHT
  GEAR 5 GAS GEAR 5 GAS GEAR 5 GAS GEAR 5 GAS GEAR 5 GAS GAS
  GEAR 5 LEFT

  # Coupled countdown of c4 and c5
  GEAR 4 RIGHT               # move to c4
  PARK                        # while c4 > 0
    GEAR 4 LEFT
    GEAR 5 RIGHT              # move to c5

    # Copy c5 → c6 (restore via c7)
    PARK
      BRAKE
      RIGHT GAS               # c6++
      RIGHT GAS               # c7++
      GEAR 2 LEFT              # back to c5
    DRIVE
    GEAR 2 RIGHT              # move to c7
    PARK
      BRAKE
      GEAR 2 LEFT GAS          # c5++
      GEAR 2 RIGHT             # back to c7
    DRIVE
    GEAR 5 LEFT GEAR 2 LEFT    # back to c0
    GEAR 5 RIGHT GEAR 2 RIGHT GAS  # c7++ (flag)
    GEAR 5 LEFT GEAR 2 LEFT    # back to c0

    # Zero-check on c6: if c6 != 0, clear it and clear c7
    GEAR 5 RIGHT RIGHT         # move to c6
    PARK
      PARK BRAKE DRIVE         # zero c6
      RIGHT BRAKE LEFT         # c7--
    DRIVE
    GEAR 5 LEFT LEFT           # back to c0

    # Move c7 result → c2 (is_upper flag)
    GEAR 5 RIGHT GEAR 2 RIGHT  # move to c7
    PARK
      PARK BRAKE DRIVE         # zero c7
      GEAR 3 LEFT              # move to c2
      PARK BRAKE DRIVE         # zero c2
      GEAR 3 RIGHT             # back to c7
    DRIVE
    GEAR 5 LEFT GEAR 2 LEFT    # back to c0

    # Decrement c4, c5
    GEAR 4 RIGHT BRAKE         # c4--
    GEAR 4 LEFT
  GEAR 5 RIGHT BRAKE GEAR 5 LEFT  # c5--

  # Exit coupled countdown
  GEAR 4 RIGHT
  DRIVE
  GEAR 4 LEFT

  # ── Finalize is_upper: move leftover c5 → c2 ──
  GEAR 5 RIGHT
  PARK
    PARK BRAKE DRIVE           # zero c5
    GEAR 3 LEFT GAS            # c2++
    GEAR 3 RIGHT
  DRIVE
  GEAR 5 LEFT

  # ══════════════════════════════════════════
  # LOWERCASE CHECK: is c0 in a-z (97-122)?
  # ══════════════════════════════════════════

  # Copy c0 → c4 again (same pattern)
  PARK
    BRAKE
    GEAR 4 RIGHT GAS
    GEAR 2 RIGHT GAS
    GEAR 5 LEFT LEFT
  DRIVE
  GEAR 5 RIGHT RIGHT
  PARK
    BRAKE
    GEAR 5 LEFT LEFT GAS
    GEAR 5 RIGHT RIGHT
  DRIVE
  GEAR 5 LEFT LEFT

  # Subtract 97 from c4  (19 × GEAR 5 BRAKE + GEAR 2 BRAKE = 97)
  GEAR 4 RIGHT
  GEAR 5 BRAKE GEAR 5 BRAKE GEAR 5 BRAKE GEAR 5 BRAKE
  GEAR 5 BRAKE GEAR 5 BRAKE GEAR 5 BRAKE GEAR 5 BRAKE
  GEAR 5 BRAKE GEAR 5 BRAKE GEAR 5 BRAKE GEAR 5 BRAKE
  GEAR 5 BRAKE GEAR 5 BRAKE GEAR 5 BRAKE GEAR 5 BRAKE
  GEAR 5 BRAKE GEAR 5 BRAKE GEAR 5 BRAKE GEAR 2 BRAKE
  GEAR 4 LEFT

  # Set c5 = 26  (range width: 122 − 97 + 1)
  GEAR 5 RIGHT
  GEAR 5 GAS GEAR 5 GAS GEAR 5 GAS GEAR 5 GAS GEAR 5 GAS GAS
  GEAR 5 LEFT

  # Coupled countdown of c4 and c5 (same pattern as uppercase)
  GEAR 4 RIGHT
  PARK
    GEAR 4 LEFT
    GEAR 5 RIGHT
    PARK
      BRAKE
      RIGHT GAS
      RIGHT GAS
      GEAR 2 LEFT
    DRIVE
    GEAR 2 RIGHT
    PARK
      BRAKE
      GEAR 2 LEFT GAS
      GEAR 2 RIGHT
    DRIVE
    GEAR 5 LEFT GEAR 2 LEFT
    GEAR 5 RIGHT GEAR 2 RIGHT GAS
    GEAR 5 LEFT GEAR 2 LEFT

    GEAR 5 RIGHT RIGHT
    PARK
      PARK BRAKE DRIVE
      RIGHT BRAKE LEFT
    DRIVE
    GEAR 5 LEFT LEFT

    GEAR 5 RIGHT GEAR 2 RIGHT
    PARK
      PARK BRAKE DRIVE
      GEAR 3 LEFT
      PARK BRAKE DRIVE
      GEAR 3 RIGHT
    DRIVE
    GEAR 5 LEFT GEAR 2 LEFT

    GEAR 4 RIGHT BRAKE
    GEAR 4 LEFT
  GEAR 5 RIGHT BRAKE GEAR 5 LEFT

  GEAR 4 RIGHT
  DRIVE
  GEAR 4 LEFT

  # ── Finalize is_lower: move leftover c5 → c3 ──
  GEAR 5 RIGHT
  PARK
    PARK BRAKE DRIVE
    GEAR 2 LEFT GAS            # c3++
    GEAR 2 RIGHT
  DRIVE
  GEAR 5 LEFT

  # ══════════════════════════════════════════
  # APPLY CASE FLIP
  # ══════════════════════════════════════════

  # If is_upper (c2 != 0): add 32 to c0
  GEAR 2 RIGHT                 # move to c2
  PARK
    PARK BRAKE DRIVE           # zero c2
    GEAR 2 LEFT                # back to c0
    GEAR 5 GAS GEAR 5 GAS GEAR 5 GAS GEAR 5 GAS
    GEAR 5 GAS GEAR 5 GAS GEAR 2 GAS   # c0 += 32
    GEAR 2 RIGHT               # back to c2
  DRIVE
  GEAR 2 LEFT                  # back to c0

  # If is_lower (c3 != 0): subtract 32 from c0
  GEAR 3 RIGHT                 # move to c3
  PARK
    PARK BRAKE DRIVE           # zero c3
    GEAR 3 LEFT                # back to c0
    GEAR 5 BRAKE GEAR 5 BRAKE GEAR 5 BRAKE GEAR 5 BRAKE
    GEAR 5 BRAKE GEAR 5 BRAKE GEAR 2 BRAKE   # c0 -= 32
    GEAR 3 RIGHT               # back to c3
  DRIVE
  GEAR 3 LEFT                  # back to c0

  # ── Print result and read next character ──
  HONK
  LISTEN

DRIVE
